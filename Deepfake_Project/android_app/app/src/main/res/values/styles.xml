<resources>
    <style name="Theme.DeepfakeDetector" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.Deepfake.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Deepfake.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/brand</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
